# Copy this file to .env and fill in your key. Never commit .env.
# Without a key, Timber runs in demo mode.
MODEL_API_KEY=

# Optional overrides (defaults shown)
# META_BASE_URL=https://api.meta.ai/v1
# META_ASR_URL=wss://api.meta.ai/v1/asr/realtime
# MUSE_SPARK_MODEL=muse-spark-1.3
# MUSE_WONDER_MODEL=muse-wonder-1.0
# MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# SAM_MODEL=sam-3.1
# MUSE_IMAGE_MODEL=muse-image-1.0

# Home Assistant: drive real lights, speakers and thermostats
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# HA_LIGHT=light.living_room
# HA_SPEAKER=media_player.living_room
# HA_THERMOSTAT=climate.home

# Schedules (local time)
# TIMBER_REFLECT_AT=02:00          # nightly review on Muse Wonder (reviews the day before)
# TIMBER_ORIENT_AT=08:00           # Dementia mode: morning orientation
# TIMBER_PRACTICE_AT=10:30,15:00   # Dementia mode: gentle activities

# Storage
# TIMBER_DB=data/timber.db
